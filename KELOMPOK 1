from pptx import Presentation
from pptx.util import Inches

# Buat presentasi baru
prs = Presentation()

# Fungsi helper untuk menambah slide dengan judul dan isi
def add_slide(title, content_list, layout_idx=1):
    slide_layout = prs.slide_layouts[layout_idx]  # 1 = Title and Content
    slide = prs.slides.add_slide(slide_layout)
    title_placeholder = slide.shapes.title
    title_placeholder.text = title
    content_placeholder = slide.placeholders[1]
    content_placeholder.text = "\n".join(content_list)

